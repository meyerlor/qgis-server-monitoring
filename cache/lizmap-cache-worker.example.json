{
  "db_path": "/var/lib/lizmap-cache/cache.db",
  "php": "/usr/bin/php",

  "instances": [
    {"name": "markdorf", "lizmap_path": "/var/www/markdorf/lizmap"},
    {"name": "stockach", "lizmap_path": "/var/www/stockach/lizmap"}
  ],

  "pools": [
    {"name": "pool4 (Seeding)", "url": "http://127.0.0.1:7004/ows/", "monitor_pool": "qgis-pool4"},
    {"name": "pool1", "url": "http://127.0.0.1:7001/ows/"}
